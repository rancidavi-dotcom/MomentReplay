{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moment-friends-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moment-social",
      "database_id": "REPLACE_WITH_THE_D1_DATABASE_ID"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "REALTIME", "class_name": "MomentRealtimeHub" }]
  },
  "triggers": { "crons": ["17 * * * *"] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MomentRealtimeHub"] }
  ]
}
